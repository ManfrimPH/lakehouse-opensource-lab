# ==============================================================================
# LAKEHOUSE OPEN SOURCE LAB - VARIÁVEIS DE AMBIENTE (TEMPLATE PÚBLICO)
# Arquitetura: MinIO (S3) + Apache Iceberg + Project Nessie + dbt-core + Dremio + Superset + Airflow
# Para usar: copie este arquivo para .env -> cp .env.example .env
# ==============================================================================

# --- MinIO (Object Storage S3-Compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_BUCKET=lakehouse

# --- Project Nessie (Catálogo Git para Iceberg) ---
NESSIE_PORT=19120

# --- Dremio (Motor Vetorizado Apache Arrow & Camada Semântica) ---
DREMIO_HTTP_PORT=9047
DREMIO_ODBC_PORT=31010
DREMIO_FLIGHT_PORT=32010
DREMIO_ADMIN_USER=admin
DREMIO_ADMIN_FIRSTNAME=Pedro
DREMIO_ADMIN_LASTNAME=Manfrim
DREMIO_ADMIN_EMAIL=pedro@lakehouse.local
DREMIO_ADMIN_PASSWORD=Admin1234!

# --- PostgreSQL (Metadados Airflow + Superset + Data Warehouse Auxiliar) ---
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=lakehouse123
POSTGRES_DB=lakehouse_meta
POSTGRES_PORT=5435

# --- Redis (Cache de Baixa Latência do Superset & Broker) ---
REDIS_PORT=6380

# --- Apache Superset (Visualização Democrática) ---
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=lakehouse_opensource_superset_secret_key_2026
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin

# --- Apache Airflow (Orquestração & Data CI/CD) ---
AIRFLOW_PORT=8085
AIRFLOW_UID=1000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
